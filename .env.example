# ============================================================
# STRIDE-X LLM — same variable NAMES for every provider
# Only the VALUES change. No need to unset anything.
# ============================================================

# Provider: ollama | openai | gemini | anthropic
STRIDE_X_LLM_PROVIDER=ollama

# API key (use "ollama" for local Ollama)
STRIDE_X_LLM_API_KEY=ollama

# Model name for that provider
STRIDE_X_LLM_MODEL=llama3.2

# Optional base URL override (usually leave empty)
# STRIDE_X_LLM_BASE_URL=

# --- Examples (copy one block) ---

# Ollama (default, local)
# STRIDE_X_LLM_PROVIDER=ollama
# STRIDE_X_LLM_API_KEY=ollama
# STRIDE_X_LLM_MODEL=llama3.2

# Google Gemini
# STRIDE_X_LLM_PROVIDER=gemini
# STRIDE_X_LLM_API_KEY=your-aistudio-key
# STRIDE_X_LLM_MODEL=gemini-3.8-flash

# OpenAI
# STRIDE_X_LLM_PROVIDER=openai
# STRIDE_X_LLM_API_KEY=sk-...
# STRIDE_X_LLM_MODEL=gpt-4o-mini

# Anthropic Claude
# STRIDE_X_LLM_PROVIDER=anthropic
# STRIDE_X_LLM_API_KEY=sk-ant-...
# STRIDE_X_LLM_MODEL=claude-sonnet-4-5
